{
  "name": "homeflix",
  "version": "1.0.0",
  "private": true,
  "description": "HomeFlix — app Samsung Smart TV (Tizen) para o Home Media Server.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/prepare-tizen.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "icons": "node scripts/generate-icon.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-tizen.ps1",
    "install:tv": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-tv.ps1"
  },
  "devDependencies": {
    "happy-dom": "21.0.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}

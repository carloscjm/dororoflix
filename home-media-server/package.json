{
  "name": "home-media-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor de mídia local (LAN) com streaming via HTTP Range — backend para um futuro app Samsung Tizen.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.4.0",
    "dotenv": "^18.0.9",
    "fastify": "^5.12.8",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
